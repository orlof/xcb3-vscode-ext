    },
    "INTERRUPT control": {
        "prefix": ["INTERRUPT", "interrupt"],
        "body": [
            "${1|TIMER,RASTER,SPRITE,BACKGROUND,SYSTEM|} INTERRUPT ${2|ON,OFF|}"
