    },
    "VMODE command": {
        "prefix": ["VMODE", "vmode"],
        "body": [
            "VMODE ${1|TEXT,BITMAP,EXT|} ${2|HIRES,MULTI|} ROWS ${3|24,25|} COLS ${4|38,40|}"
