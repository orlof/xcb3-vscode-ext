    },
    "DIM variable": {
        "prefix": ["DIM VAR", "dim var"],
        "body": [
            "DIM ${1|SHARED,STATIC,FAST|} ${2:variable} AS ${3|BYTE,WORD,INT,LONG,FLOAT,DECIMAL,STRING|}"
