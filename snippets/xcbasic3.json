    },
    "ON ERROR": {
        "prefix": ["ON ERROR", "on error"],
        "body": [
            "ON ERROR GOTO ${1:label}"
        ],
        "description": "Error handling"
    },
    "ON INTERRUPT": {
        "prefix": ["ON INTERRUPT", "on interrupt"],
        "body": [
            "ON ${1|TIMER,RASTER,SPRITE,BACKGROUND,VBLANK|} GOSUB ${2:label}"
        ],
        "description": "Interrupt handler"
    },
    "DECLARE SUB": {
        "prefix": ["DECLARE SUB", "declare sub"],
        "body": [
            "DECLARE SUB ${1:name}(${2:arg1} AS ${3:type}) ${4|OVERRIDE,STATIC,SHARED|}"
        ],
        "description": "Declare subroutine"
    },
    "DECLARE FUNCTION": {
        "prefix": ["DECLARE FUNCTION", "declare function"],
        "body": [
            "DECLARE FUNCTION ${1:name} AS ${2:type}(${3:arg1} AS ${4:type}) ${5|OVERRIDE,STATIC,SHARED|}"
        ],
        "description": "Declare function"
    },
    "DATA statement": {
        "prefix": ["DATA", "data"],
        "body": [
            "DATA AS ${1|BYTE,WORD,INT,LONG,FLOAT,DECIMAL,STRING|} ${2:value1}, ${3:value2}"
