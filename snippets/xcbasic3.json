    },
    "SOUND CLEAR": {
        "prefix": ["SOUND CLEAR", "sound clear"],
        "body": [
            "SOUND CLEAR"
        ],
        "description": "Clear sound channels"
    },
    "OPEN file": {
        "prefix": ["OPEN", "open"],
        "body": [
            "OPEN ${1:logical_no}, ${2:device_no}, ${3:secondary_address}, \"${4:filename}\""
