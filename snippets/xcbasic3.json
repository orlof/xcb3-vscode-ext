{
    "FOR loop": {
        "prefix": ["FOR", "for"],
        "body": [
            "FOR ${1:variable} AS ${2:INT} = ${3:start} TO ${4:end}",
            "\t$0",
            "NEXT ${1:variable}"
        ],
        "description": "FOR loop with variable declaration"
    },
    "FOR loop with STEP": {
        "prefix": ["FORSTEP", "forstep"],
        "body": [
            "FOR ${1:variable} AS ${2:INT} = ${3:start} TO ${4:end} STEP ${5:increment}",
            "\t$0",
            "NEXT ${1:variable}"
        ],
        "description": "FOR loop with STEP increment"
    },
    "IF statement": {
        "prefix": ["IF", "if"],
        "body": [
            "IF ${1:condition} THEN",
            "\t$0",
            "END IF"
        ],
        "description": "IF statement"
    },
    "IF ELSE statement": {
        "prefix": ["IFELSE", "ifelse"],
        "body": [
            "IF ${1:condition} THEN",
            "\t${2:// true code}",
            "ELSE",
            "\t${3:// false code}",
            "END IF"
        ],
        "description": "IF ELSE statement"
    },
    "WHILE loop": {
        "prefix": ["WHILE", "while"],
        "body": [
            "DO WHILE ${1:condition}",
            "\t$0",
            "LOOP"
        ],
        "description": "WHILE loop"
    },
    "DO UNTIL loop": {
        "prefix": ["UNTIL", "until"],
        "body": [
            "DO",
            "\t$0",
            "LOOP UNTIL ${1:condition}"
        ],
        "description": "DO UNTIL loop"
    },
    "SUB procedure": {
        "prefix": ["SUB", "sub"],
        "body": [
            "SUB ${1:name}(${2:parameters})",
            "\t$0",
            "END SUB"
        ],
        "description": "SUB procedure definition"
    },
    "FUNCTION": {
        "prefix": ["FUNCTION", "function"],
        "body": [
            "FUNCTION ${1:name}(${2:parameters}) AS ${3:type}",
            "\t$0",
            "\tRETURN ${4:value}",
            "END FUNCTION"
        ],
        "description": "FUNCTION definition"
    },
    "SELECT CASE": {
        "prefix": ["SELECT", "select"],
        "body": [
            "SELECT CASE ${1:expression}",
            "\tCASE ${2:value1}",
            "\t\t${3:// code}",
            "\tCASE ${4:value2}",
            "\t\t${5:// code}",
            "\tCASE ELSE",
            "\t\t${6:// default code}",
            "END SELECT"
        ],
        "description": "SELECT CASE statement"
    },
    "DIM array": {
        "prefix": ["DIM", "dim"],
        "body": [
            "DIM ${1:arrayName}(${2:size}) AS ${3:type}"
        ],
        "description": "Declare an array"
    },
    "PRINT statement": {
        "prefix": ["PRINT", "print"],
        "body": [
            "PRINT \"${1:message}\""
        ],
        "description": "PRINT statement"
    },
    "ASM block": {
        "prefix": ["ASM", "asm"],
        "body": [
            "ASM",
            "\t${1:// assembly code}",
            "END ASM"
        ],
        "description": "Inline assembly block"
    },
    "TYPE definition": {
        "prefix": ["TYPE", "type"],
        "body": [
            "TYPE ${1:TypeName}",
            "\t${2:field1} AS ${3:type}",
            "\t${4:field2} AS ${5:type}",
            "END TYPE"
        ],
        "description": "User-defined type"
    },
    "BACKGROUND color": {
        "prefix": ["BACKGROUND", "background"],
        "body": [
            "BACKGROUND ${1:color}"
        ],
        "description": "Set background color"
    },
    "BORDER color": {
        "prefix": ["BORDER", "border"],
        "body": [
            "BORDER ${1:color}"
        ],
        "description": "Set border color"
    },
    "LOCATE position": {
        "prefix": ["LOCATE", "locate"],
        "body": [
            "LOCATE ${1:x_pos}, ${2:y_pos}"
        ],
        "description": "Set cursor position"
    },
    "POKE memory": {
        "prefix": ["POKE", "poke"],
        "body": [
            "POKE ${1:address}, ${2:value}"
        ],
        "description": "Write byte to memory address"
    },
    "DOKE memory": {
        "prefix": ["DOKE", "doke"],
        "body": [
            "DOKE ${1:address}, ${2:value}"
        ],
        "description": "Write word to memory address"
    },
    "SWAP variables": {
        "prefix": ["SWAP", "swap"],
        "body": [
            "SWAP ${1:left}, ${2:right}"
        ],
        "description": "Swap two variables"
    },
    "ERROR code": {
        "prefix": ["ERROR", "error"],
        "body": [
            "ERROR ${1:error_code}"
        ],
        "description": "Generate error with code"
    },
    "GOSUB label": {
        "prefix": ["GOSUB", "gosub"],
        "body": [
            "GOSUB ${1:label}"
        ],
        "description": "Call subroutine at label"
    },
    "GOTO label": {
        "prefix": ["GOTO", "goto"],
        "body": [
            "GOTO ${1:label}"
        ],
        "description": "Jump to label"
    },
    "RANDOMIZE seed": {
        "prefix": ["RANDOMIZE", "randomize"],
        "body": [
            "RANDOMIZE ${1:value}"
        ],
        "description": "Initialize random number generator"
    },
    "SCREEN number": {
        "prefix": ["SCREEN", "screen"],
        "body": [
            "SCREEN ${1:screen_number}"
        ],
        "description": "Switch to screen number"
    },
    "MEMCPY operation": {
        "prefix": ["MEMCPY", "memcpy"],
        "body": [
            "MEMCPY ${1:source_address}, ${2:destination_address}, ${3:length}"
        ],
        "description": "Copy memory block"
    },
    "MEMSHIFT operation": {
        "prefix": ["MEMSHIFT", "memshift"],
        "body": [
            "MEMSHIFT ${1:source_address}, ${2:destination_address}, ${3:length}"
        ],
        "description": "Shift memory block"
    },
    "CHARAT display": {
        "prefix": ["CHARAT", "charat"],
        "body": [
            "CHARAT ${1:x_pos}, ${2:y_pos}, ${3:screencode}${4:, ${5:color}}"
        ],
        "description": "Display character at position"
    },
    "TEXTAT display": {
        "prefix": ["TEXTAT", "textat"],
        "body": [
            "TEXTAT ${1:x_pos}, ${2:y_pos}, \"${3:text}\"${4:, ${5:color}}"
        ],
        "description": "Display text at position"
    },
    "CHARSET mode": {
        "prefix": ["CHARSET", "charset"],
        "body": [
            "CHARSET ${1|RAM,ROM|} ${2:value}"
        ],
        "description": "Set character set"
    },
    "CONTINUE loop": {
        "prefix": ["CONTINUE", "continue"],
        "body": [
            "CONTINUE ${1|FOR,DO|}"
        ],
        "description": "Continue loop execution"
    },
    "HSCROLL pixels": {
        "prefix": ["HSCROLL", "hscroll"],
        "body": [
            "HSCROLL ${1:px}"
        ],
        "description": "Horizontal scroll"
    },
    "VSCROLL pixels": {
        "prefix": ["VSCROLL", "vscroll"],
        "body": [
            "VSCROLL ${1:px}"
        ],
        "description": "Vertical scroll"
    },
    "SYS call": {
        "prefix": ["SYS", "sys"],
        "body": [
            "SYS ${1:address}${2: FAST}"
        ],
        "description": "System call to machine language routine"
    },
    "WAIT sync": {
        "prefix": ["WAIT", "wait"],
        "body": [
            "WAIT ${1:address}, ${2:mask}${3:, ${4:trig}}"
        ],
        "description": "Wait for memory condition"
    },
    "SPRITE command": {
        "prefix": ["SPRITE", "sprite"],
        "body": [
            "SPRITE ${1:spr_no} ${2|ON,OFF|} AT ${3:x}, ${4:y} SHAPE ${5:n} COLOR ${6:c} ${7|HIRES,MULTI|} XYSIZE ${8:x}, ${9:y} ${10|ON BACKGROUND,UNDER BACKGROUND|}"
        ],
        "description": "Configure sprite with all subcommands"
    },
    "SPRITE CLEAR HIT": {
        "prefix": ["SPRITE CLEAR HIT", "sprite clear hit"],
        "body": [
            "SPRITE CLEAR HIT"
        ],
        "description": "Clear sprite collision flags"
    },
    "SPRITE MULTICOLOR": {
        "prefix": ["SPRITE MULTICOLOR", "sprite multicolor"],
        "body": [
            "SPRITE MULTICOLOR ${1:col1}, ${2:col2}"
        ],
        "description": "Set sprite multicolor mode"
    },
    "VOICE command": {
        "prefix": ["VOICE", "voice"],
        "body": [
            "VOICE ${1:voice_no} ${2:subcmd}"
        ],
        "description": "Configure sound voice"
    },
    "VOLUME setting": {
        "prefix": ["VOLUME", "volume"],
        "body": [
