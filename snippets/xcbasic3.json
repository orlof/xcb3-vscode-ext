    },
    "FILTER command": {
        "prefix": ["FILTER", "filter"],
        "body": [
            "FILTER ${1:sid_number} CUTOFF ${2:cutoff_freq} RESONANCE ${3:value} ${4|LOW,BAND,HIGH|} PASS"
        ],
        "description": "Configure audio filter"
    },
    "ON command": {
        "prefix": ["ON", "on"],
        "body": [
            "ON ${1:value} ${2|GOTO,GOSUB|} ${3:label1}, ${4:label2}"
        ],
