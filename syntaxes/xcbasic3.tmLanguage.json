{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XC-BASIC3",
  "scopeName": "source.xcbasic3",
  "patterns": [
    { "include": "#options" },
    { "include": "#asm-expression" },
    { "include": "#invalid" },
    { "include": "#types" },
    { "include": "#interrupts" },
    { "include": "#charset" },

    { "include": "#vmode-command" },
    { "include": "#sprite-command" },
    { "include": "#voice-command" },
    { "include": "#filter-command" },
    { "include": "#screen-command" },
    { "include": "#sound-command" },
    { "include": "#background-command" },
    { "include": "#border-command" },
    { "include": "#charat-command" },

    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#type" },
    { "include": "#sub" },
    { "include": "#call" },
    { "include": "#as" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#comments" },
    { "include": "#numerics" },
    { "include": "#hexanumerics" },
    { "include": "#labels" }
  ],
  "repository": {
    "options": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bOPTION\\s+(FASTINTERRUPT|INLINEDATA|NOBASICLOADER|STARTADDRESS|TARGET)\\b",
          "captures": { "1": { "name": "storage.modifier.xcbasic3" } }
        }
      ]
    },

    "vmode-command": {
        "patterns": [
            {
            "begin": "(?i)\\b(VMODE)\\b",
            "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
            "end": "(?=:|$)",
            "patterns": [
                {
                "name": "storage.modifier.xcbasic3",
                "match": "(?i)\\b(TEXT|BITMAP|EXT|HIRES|MULTI)\\b"
                },
                {
                "begin": "(?i)\\bROWS\\b",
                "beginCaptures": { "0": { "name": "storage.modifier.xcbasic3" } },
                "end": "(?=\\s*(?:\\b(TEXT|BITMAP|EXT|HIRES|MULTI|ROWS|COLS)\\b|:|$))",
                "patterns": [
                    {
                    "name": "constant.numeric.xcbasic3",
                    "match": "\\s+(24|25)\\b",
                    "captures": { "1": { "name": "constant.numeric.xcbasic3" } }
                    },
                    {
                    "begin": "\\s+\\b(SPRITEBGHIT|SPRITEHIT)\\s*\\(",
                    "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
                    "end": "\\)",
                    "patterns": [
                        { "include": "#builtins" },
                        { "include": "#strings" },
                        { "include": "#hexanumerics" },
                        { "include": "#numerics" },
                        { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                        { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
                    ]
                    },
                    {
                    "begin": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE|LEFT|LEN|LOG|MID|PEEK|POS|POW|RIGHT|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR|TAN|TI|UCASE|VAL)\\s*\\(",
                    "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
                    "end": "\\)",
                    "patterns": [
                        { "include": "#builtins" },
                        { "include": "#strings" },
                        { "include": "#hexanumerics" },
                        { "include": "#numerics" },
                        { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                        { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
                    ]
                    },
                    {
                    "name": "keyword.control.xcbasic3",
                    "match": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR\\$?|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE\\$?|LEFT\\$?|LEN|LOG|MID\\$?|PEEK|POS|POW|RIGHT\\$?|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR\\$?|TAN|TI|UCASE\\$?|VAL)\\b"
                    },
                    { "include": "#strings" },
                    { "include": "#hexanumerics" },
                    {
                    "name": "invalid.illegal.xcbasic3",
                    "match": "\\s+([0-9]+)\\b",
                    "captures": { "1": { "name": "constant.numeric.xcbasic3" } }
                    },
                    { "include": "#numerics" },
                    { "name": "variable.name.xcbasic3", "match": "\\s+\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" }
                ]
                },
                {
                "begin": "(?i)\\bCOLS\\b",
                "beginCaptures": { "0": { "name": "storage.modifier.xcbasic3" } },
                "end": "(?=\\s*(?:\\b(TEXT|BITMAP|EXT|HIRES|MULTI|ROWS|COLS)\\b|:|$))",
                "patterns": [
                    {
                    "name": "constant.numeric.xcbasic3",
                    "match": "\\s+(38|40)\\b",
                    "captures": { "1": { "name": "constant.numeric.xcbasic3" } }
                    },
                    {
                    "begin": "\\s+\\b(SPRITEBGHIT|SPRITEHIT)\\s*\\(",
                    "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
                    "end": "\\)",
                    "patterns": [
                        { "include": "#builtins" },
                        { "include": "#strings" },
                        { "include": "#hexanumerics" },
                        { "include": "#numerics" },
                        { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                        { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
                    ]
                    },
                    {
                    "begin": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE|LEFT|LEN|LOG|MID|PEEK|POS|POW|RIGHT|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR|TAN|TI|UCASE|VAL)\\s*\\(",
                    "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
                    "end": "\\)",
                    "patterns": [
                        { "include": "#builtins" },
                        { "include": "#strings" },
                        { "include": "#hexanumerics" },
                        { "include": "#numerics" },
                        { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                        { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
                    ]
                    },
                    {
                    "name": "keyword.control.xcbasic3",
                    "match": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR\\$?|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE\\$?|LEFT\\$?|LEN|LOG|MID\\$?|PEEK|POS|POW|RIGHT\\$?|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR\\$?|TAN|TI|UCASE\\$?|VAL)\\b"
                    },
                    { "include": "#strings" },
                    { "include": "#hexanumerics" },
                    {
                    "name": "invalid.illegal.xcbasic3",
                    "match": "\\s+([0-9]+)\\b",
                    "captures": { "1": { "name": "constant.numeric.xcbasic3" } }
                    },
                    { "include": "#numerics" },
                    { "name": "variable.name.xcbasic3", "match": "\\s+\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" }
                ]
                }
            ]
            }
        ]
    },

    "sprite-command": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bSPRITE\\s+CLEAR\\s+HIT\\b"
        },
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bSPRITE\\s+MULTICOLOR\\b"
        },
        {
          "begin": "(?i)\\bSPRITE\\s+CLEAR\\b",
          "beginCaptures": { "0": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" }
          ]
        },
        {
          "begin": "(?i)\\b(SPRITE)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            {
            "begin": "\\s+\\b(SPRITEBGHIT|SPRITEHIT)\\s*\\(",
            "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
            "end": "\\)",
            "patterns": [
                { "include": "#builtins" },
                { "include": "#strings" },
                { "include": "#hexanumerics" },
                { "include": "#numerics" },
                { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
            ]
            },
            {
            "begin": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE|LEFT|LEN|LOG|MID|PEEK|POS|POW|RIGHT|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR|TAN|TI|UCASE|VAL)\\s*\\(",
            "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
            "end": "\\)",
            "patterns": [
                { "include": "#builtins" },
                { "include": "#strings" },
                { "include": "#hexanumerics" },
                { "include": "#numerics" },
                { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
            ]
            },
            {
            "name": "keyword.control.xcbasic3",
            "match": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR\\$?|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE\\$?|LEFT\\$?|LEN|LOG|MID\\$?|PEEK|POS|POW|RIGHT\\$?|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR\\$?|TAN|TI|UCASE\\$?|VAL)\\b"
            },
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\b(ON|OFF|AT|SHAPE|COLOR|HIRES|MULTI|MULTICOLOR|LOWCOL|HICOL|XYSIZE|ZDEPTH|XYFLIP)\\b" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\b(?:ON|UNDER)\\s+BACKGROUND\\b" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\bBACKGROUND\\b" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        }
      ]
    },

    "voice-command": {
      "patterns": [
        {
          "begin": "(?i)\\b(VOICE)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            {
            "begin": "\\s+\\b(SPRITEBGHIT|SPRITEHIT)\\s*\\(",
            "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
            "end": "\\)",
            "patterns": [
                { "include": "#builtins" },
                { "include": "#strings" },
                { "include": "#hexanumerics" },
                { "include": "#numerics" },
                { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
            ]
            },
            {
            "begin": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE|LEFT|LEN|LOG|MID|PEEK|POS|POW|RIGHT|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR|TAN|TI|UCASE|VAL)\\s*\\(",
            "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
            "end": "\\)",
            "patterns": [
                { "include": "#builtins" },
                { "include": "#strings" },
                { "include": "#hexanumerics" },
                { "include": "#numerics" },
                { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
            ]
            },
            {
            "name": "keyword.control.xcbasic3",
            "match": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR\\$?|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE\\$?|LEFT\\$?|LEN|LOG|MID\\$?|PEEK|POS|POW|RIGHT\\$?|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR\\$?|TAN|TI|UCASE\\$?|VAL)\\b"
            },
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\b(ON|OFF|LEFT|RIGHT|VOLUME|TONE|ADSR|PULSE)\\b" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\bWAVE\\b" },
            { "name": "constant.language.xcbasic3", "match": "(?i)\\b(SAW|PULSE|NOISE|TRI)\\b" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\bFILTER\\s+(ON|OFF)\\b", "captures": { "1": { "name": "constant.language.xcbasic3" } } },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        }
      ]
    },

    "filter-command": {
      "patterns": [
        {
          "begin": "(?i)\\b(FILTER)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            {
            "begin": "\\s+\\b(SPRITEBGHIT|SPRITEHIT)\\s*\\(",
            "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
            "end": "\\)",
            "patterns": [
                { "include": "#builtins" },
                { "include": "#strings" },
                { "include": "#hexanumerics" },
                { "include": "#numerics" },
                { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
            ]
            },
            {
            "begin": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE|LEFT|LEN|LOG|MID|PEEK|POS|POW|RIGHT|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR|TAN|TI|UCASE|VAL)\\s*\\(",
            "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
            "end": "\\)",
            "patterns": [
                { "include": "#builtins" },
                { "include": "#strings" },
                { "include": "#hexanumerics" },
                { "include": "#numerics" },
                { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
                { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
            ]
            },
            {
            "name": "keyword.control.xcbasic3",
            "match": "\\s+\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR\\$?|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE\\$?|LEFT\\$?|LEN|LOG|MID\\$?|PEEK|POS|POW|RIGHT\\$?|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR\\$?|TAN|TI|UCASE\\$?|VAL)\\b"
            },
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\b(CUTOFF|RESONANCE)\\b" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\b(LOW|BAND|HIGH)\\s+PASS\\b" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        }
      ]
    },

    "screen-command": {
      "patterns": [
        {
          "begin": "(?i)\\b(SCREEN)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\b(ROWS|COLS|TEXTAT|HSCROLL|VSCROLL)\\b" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        }
      ]
    },

    "sound-command": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bSOUND\\s+CLEAR\\b"
        },
        {
          "begin": "(?i)\\b(SOUND)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "storage.modifier.xcbasic3", "match": "(?i)\\b(CLEAR|AT|VOLUME|FREQ|TONE|WAVE)\\b" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        }
      ]
    },

    "background-command": {
      "patterns": [
        {
          "begin": "(?i)\\b(BACKGROUND)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        }
      ]
    },

    "border-command": {
      "patterns": [
        {
          "begin": "(?i)\\b(BORDER)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        }
      ]
    },

    "charat-command": {
      "patterns": [
        {
          "begin": "(?i)\\b(CHARAT)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?=:|$)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        }
      ]
    },

    "asm-expression": {
      "begin": "(?i)\\bASM\\b",
      "end": "(?i)\\bEND\\s+ASM\\b",
      "name": "keyword.control.xcbasic3",
      "patterns": [
        { "include": "#asm-comments" },
        { "include": "#asm-constants" },
        { "include": "#asm-operators" },
        { "include": "#asm-pseudoops" },
        { "include": "#asm-instructions" },
        { "include": "#asm-registers" },
        { "include": "#asm-labels" }
      ]
    },

    "type": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bTYPE\\s+([a-z_][a-z_0-9]*\\$?)",
          "captures": { "1": { "name": "entity.name.type.xcbasic3" } }
        }
      ]
    },

    "as": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bAS\\s+([a-z_][a-z_0-9]*\\$?)\\b",
          "captures": { "1": { "name": "entity.name.type.xcbasic3" } }
        }
      ]
    },

    "types": {
      "patterns": [
        { "name": "entity.name.type.xcbasic3", "match": "(?i)\\b(BYTE|WORD|INT|LONG|FLOAT|DECIMAL|STRING)\\b" }
      ]
    },

    "sub": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\b(?:SUB|FUNCTION)\\s+([a-z_][a-z_0-9]*\\$?)\\b",
          "captures": { "1": { "name": "entity.name.function.xcbasic3" } }
        }
      ]
    },

    "interrupts": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\b(?:TIMER|RASTER|SPRITE|BACKGROUND|SYSTEM)\\s+INTERRUPT\\s+(ON|OFF)\\b",
          "captures": { "1": { "name": "constant.language.xcbasic3" } }
        },
        {
          "begin": "(?i)\\b(ON)\\s+(ERROR)\\s+(GOTO)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.xcbasic3" },
            "2": { "name": "storage.modifier.xcbasic3" },
            "3": { "name": "keyword.control.xcbasic3" }
          },
          "end": "(?=:|$)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        },
        {
          "begin": "(?i)\\b(ON)\\s+(TIMER|RASTER)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.xcbasic3" },
            "2": { "name": "storage.modifier.xcbasic3" }
          },
          "end": "(?i)\\s+(GOSUB)\\b",
          "endCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" }
          ]
        },
        {
          "begin": "(?i)\\b(ON)\\s+(SPRITE|BACKGROUND|VBLANK)\\s+(GOSUB)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.xcbasic3" },
            "2": { "name": "storage.modifier.xcbasic3" },
            "3": { "name": "keyword.control.xcbasic3" }
          },
          "end": "(?=:|$)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        },
        {
          "begin": "(?i)\\b(ON)\\s+(?!(ERROR|TIMER|RASTER|SPRITE|BACKGROUND|VBLANK)\\b)",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "(?i)\\s+(GOTO|GOSUB)\\b",
          "endCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "include": "#builtins" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" }
          ]
        }
      ]
    },

    "charset": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bCHARSET(?:\\s+(RAM|ROM))?\\b",
          "captures": { "1": { "name": "constant.language.xcbasic3" } }
        }
      ]
    },

    "call": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bCALL\\s+([a-z_][a-z_0-9]*\\$?)\\b",
          "captures": { "1": { "name": "entity.name.function.xcbasic3" } }
        }
      ]
    },

    "comments": {
      "patterns": [
        { "name": "comment.line.rem.xcbasic3", "begin": "(?i)(?<!\\w)REM\\b", "end": "$" },
        { "name": "comment.line.apostrophe.xcbasic3", "begin": "'", "end": "$" }
      ]
    },

    "labels": {
      "patterns": [
        {
          "name": "variable.name.xcbasic3",
          "match": "(?i)\\b(?!(?:CASE|CONST|CONTINUE|DATA|DECLARE|DIM|DO|ELSE|ERROR|EXIT|FOR|GOSUB|GOTO|IF|INCBIN|INCLUDE|LET|LOOP|NEXT|ON|ORIGIN|OVERRIDE|RETURN|SELECT|STEP|SYS|THEN|THIS|TO|UNTIL|WHILE|PRINT|INPUT|OPEN|CLOSE|LOAD|SAVE|READ|WRITE|POKE|DOKE|GET|LOCATE|HSCROLL|VSCROLL|RANDOMIZE|BORDER|BACKGROUND|TEXTAT|COLS|ROWS|CHARAT|SCREEN|SOUND|MEMCPY|MEMSHIFT|MEMSET|SWAP|WAIT|VOLUME|ABS|ASC|ATN|CBYTE|CFLOAT|CHR|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE|LEFT|LEN|LOG|MID|PEEK|POS|POW|RIGHT|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SPRITEBGHIT|SPRITEHIT|SQR|ST|STR|TAN|TI|UCASE|VAL|BYTE|WORD|LONG|FLOAT|DECIMAL|STRING|AND|OR|XOR|NOT|MOD|OVERLOAD|PRIVATE|STATIC|SHARED|FAST)\\b)[a-z_][a-z_0-9]*\\$?\\b"
        }
      ]
    },

    "numerics": {
      "patterns": [
        { "name": "constant.numeric.decimal.xcbasic3", "match": "\\b[0-9]+\\b" }
      ]
    },

    "hexanumerics": {
      "patterns": [
        { "name": "constant.numeric.hex.xcbasic3", "match": "\\$[0-9a-fA-F]+\\b" }
      ]
    },

    "invalid": {
      "patterns": [
        { "name": "invalid.illegal.xcbasic3", "match": "(?i)\\bINLINE\\b" }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\b(CASE(?:\\s+(?:IS|ELSE))?|CONST|CONTINUE|DATA|DECLARE|DIM|DO|ELSE|ERROR|EXIT\\s+(?:DO|FOR|FUNCTION|SUB)|FOR|GOSUB|GOTO|IF|INCBIN|INCLUDE|LET|LOOP|NEXT|ORIGIN|OVERRIDE|RETURN|SELECT\\s+CASE|STEP|SYS|THEN|THIS|TO|UNTIL|WHILE)\\b"
        },
        {
          "name": "storage.modifier.xcbasic3",
          "match": "(?i)\\b(OVERLOAD|PRIVATE|STATIC|SHARED|FAST)\\b"
        },
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\bEND\\s+(?:SELECT|SUB|TYPE|FUNCTION|IF|ASM)\\b"
        },
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)^\\s*END\\s*$"
        },
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\b(PRINT|INPUT|OPEN|CLOSE|LOAD|SAVE|READ|WRITE|POKE|DOKE|GET|LOCATE|HSCROLL|VSCROLL|RANDOMIZE|TEXTAT|COLS|ROWS|SCREEN|SOUND|MEMCPY|MEMSHIFT|MEMSET|SWAP|WAIT|VOLUME)\\b"
        }
      ]
    },

    "builtins": {
      "patterns": [
        {
          "begin": "(?i)\\b(SPRITEBGHIT|SPRITEHIT)\\s*\\(",
          "beginCaptures": { "1": { "name": "keyword.control.xcbasic3" } },
          "end": "\\)",
          "patterns": [
            { "include": "#strings" },
            { "include": "#hexanumerics" },
            { "include": "#numerics" },
            { "name": "variable.name.xcbasic3", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\$?\\b" },
            { "name": "punctuation.separator.parameter.xcbasic3", "match": "," }
          ]
        },
        {
          "name": "keyword.control.xcbasic3",
          "match": "(?i)\\b(ABS|ASC|ATN|CBYTE|CFLOAT|CHR\\$?|CINT|CLONG|COS|CSRLIN|CWORD|DEEK|ERR|EXP|FLOOR|JOY|KEY|LCASE\\$?|LEFT\\$?|LEN|LOG|MID\\$?|PEEK|POS|POW|RIGHT\\$?|RND|RNDB|RNDI|RNDL|RNDW|SCAN|SGN|SHL|SHR|SIN|SQR|ST|STR\\$?|TAN|TI|UCASE\\$?|VAL)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.xcbasic3", "match": "(?i)(\\*|\\bTO\\b|/|\\+|-|@|=|<>|<|>|<=|>=|\\bAND\\b|\\bOR\\b|\\bXOR\\b|\\bNOT\\b|\\bMOD\\b)" }
      ]
    },

    "strings": {
      "name": "string.quoted.double.xcbasic3",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.xcbasic3", "match": "\\\\." }
      ]
    },

    "asm-labels": {
      "patterns": [
        { "name": "entity.name.function.dasm", "match": "^[A-Za-z_][A-Za-z0-9_]*\\b(?!\\s*=)" },
        { "name": "variable.name.dasm", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },

    "asm-pseudoops": {
      "patterns": [
        { "name": "keyword.directive.dasm", "match": "(?i)\\b(INCLUDE|INCDIR|SEG|SEG\\.U|DC|DC\\.BWL|DV|DV\\.BWL|HEX|ORG|RORG|REND|ALIGN|SUBROUTINE|EQU|EQM|SET|MAC|ENDM|MEXIT|IFCONST|IFNCONST|IF|ELSE|ENDIF|EIF|REPEAT|REPEND|LIST\\s+ON|LIST\\s+OFF|PROCESSOR)\\b" },
        { "name": "keyword.operator.assignment.dasm", "match": "=" }
      ]
    },

    "asm-instructions": {
      "patterns": [
        { "name": "keyword.control.xcbasic3", "match": "(?i)\\b(BCC|BCS|BEQ|BMI|BNE|BPL|BRK|BVC|BVS|JMP|JSR|RTI|RTS)\\b" },
        { "name": "storage.modifier.xcbasic3", "match": "(?i)\\b(ADC|AND|ASL|BIT|CLC|CLD|CLI|CLV|CMP|CPX|CPY|DEC|DEX|DEY|EOR|INC|INX|INY|LDA|LDX|LDY|LSR|NOP|ORA|PHA|PHP|PLA|PLP|ROL|ROR|SBC|SEC|SED|SEI|STA|STX|STY|TAX|TAY|TSX|TXA|TXS|TYA)\\b" }
      ]
    },

    "asm-registers": {
      "patterns": [
        { "name": "keyword.register.dasm", "match": "(?i)\\b(PC|AC|X|Y|SR|SP)\\b" }
      ]
    },

    "asm-comments": {
      "patterns": [
        { "name": "comment.line.semicolon.dasm", "begin": ";", "end": "$" }
      ]
    },

    "asm-constants": {
      "patterns": [
        { "include": "#asm-constants-numeric" },
        { "include": "#asm-constants-string" }
      ]
    },

    "asm-constants-numeric": {
      "patterns": [
        { "name": "constant.numeric.binary.dasm", "match": "%[01]+\\b" },
        { "name": "constant.numeric.hexadecimal.dasm", "match": "\\$[0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.octal.dasm", "match": "\\b0[0-7]+\\b" },
        { "name": "constant.numeric.decimal.dasm", "match": "\\b[0-9]+\\b" }
      ]
    },

    "asm-constants-string": {
      "name": "string.quoted.double.dasm",
      "begin": "\"",
      "end": "\""
    },

    "asm-operators": {
      "patterns": [
        { "name": "keyword.operator.dasm", "match": "(\\*|/|%|\\+|-|<<|>>|>|>=|<|<=|==|=|!=|&|\\^|\\||&&|\\|\\||\\?|\\[|\\]|,)" }
      ]
    }
  }
}
