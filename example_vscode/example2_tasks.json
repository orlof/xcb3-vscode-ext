{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Vice XC=BASIC3",
            "type": "shell",
            "osx": {
                "command": "open",
                "args": [
                    "build/${fileBasenameNoExtension}.prg"
                ]
            },
            "windows": {
                "command": "${config:xcbasic3.emulator}",
                "args": [
                    "build/${fileBasenameNoExtension}.prg"
                ]
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "Compile XC=BASIC3"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Compile XC=BASIC3",
            "type": "shell",
            "osx": {
                "command": "${command:orlof-xcbasic3.compilerPath}",
                "args": [
                    "${file}",
                    "build/${fileBasenameNoExtension}.prg"
                ]
            },
            "windows": {
                "command": "${command:orlof-xcbasic3.compilerPath}",
                "args": [
                    "${file}",
                    "build/_${fileBasenameNoExtension}.prg"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}
