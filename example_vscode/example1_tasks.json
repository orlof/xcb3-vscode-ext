{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run MyGame",
            "type": "shell",
            "osx": {
                "command": "open",
                "args": [
                    "build/mygame.d64"
                ]
            },
            "windows": {
                "command": "${config:xcbasic3.emulator}",
                "args": [
                    "build/mygame.d64"
                ]
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build mygame.d64"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build mygame.d64",
            "type": "shell",
            "osx": {
                "command": "C:/path/to/vice/bin/c1541",
                "args": [
                    "-format",
                    "mygame,of",
                    "d64",
                    "build/mygame.d64",
                    "-attach",
                    "build/mygame.d64",
                    "-write",
                    "build/part1.prg",
                    "loader",
                    "-write",
                    "build/part2.prg",
                    "battle"
                ]
            },
            "windows": {
                "command": "C:/path/to/vice/bin/c1541.exe",
                "args": [
                    "-format",
                    "mygame,of",
                    "d64",
                    "build/mygame.d64",
                    "-attach",
                    "build/mygame.d64",
                    "-write",
                    "build/part1.prg",
                    "loader",
                    "-write",
                    "build/part2.prg",
                    "intro",
                    "battle"
                ]
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "EXOMIZE part1",
                "XCB3 part2"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "EXOMIZE part1",
            "type": "shell",
            "osx": {
                "command": "/path/to/exomizer",
                "args": [
                    "sfx",
                    "basic",
                    "build/_part1.prg",
                    "-o",
                    "build/part1.prg",
                    "-x",
                    "'inc $d020'"
                ]
            },
            "windows": {
                "command": "/path/to/exomizer.exe",
                "args": [
                    "sfx",
                    "basic",
                    "build/_part1.prg",
                    "-o",
                    "build/part1.prg",
                    "-x",
                    "'inc $d020'"
                ]
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "XCB3 part1"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "XCB3 part1",
            "type": "shell",
            "osx": {
                "command": "${command:orlof-xcbasic3.compilerPath}",
                "args": [
                    "part1.bas",
                    "build/_part1.prg"
                ]
            },
            "windows": {
                "command": "${command:orlof-xcbasic3.compilerPath}",
                "args": [
                    "part1.bas",
                    "build/_part1.prg"
                ]
            }
        },
        {
            "label": "XCB3 part2",
            "type": "shell",
            "osx": {
                "command": "${command:orlof-xcbasic3.compilerPath}",
                "args": [
                    "part2.bas",
                    "build/part2.prg"
                ]
            },
            "windows": {
                "command": "${command:orlof-xcbasic3.compilerPath}",
                "args": [
                    "part2.bas",
                    "build/part2.prg"
                ]
            }
        },
        {
            "label": "XCB3",
            "type": "shell",
            "osx": {
                "command": "${command:orlof-xcbasic3.compilerPath}",
                "args": [
                    "${file}",
                    "build/_${fileBasenameNoExtension}.prg"
                ]
            },
            "windows": {
                "command": "${command:orlof-xcbasic3.compilerPath}",
                "args": [
                    "${file}",
                    "build/_${fileBasenameNoExtension}.prg"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
