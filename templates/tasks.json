{
    // Advanced: custom build tasks for XC=BASIC 3.
    //
    // The extension compiles, runs and debugs without this file. Enable the setting
    // "xcbasic3.useTasksJson" to make Shift+F5 / Ctrl+F5 / F5 run the tasks below instead.
    //
    // ${command:orlof-xcbasic3.compilerPath} is the compiler managed by the extension (waits for the
    // download to finish) and ${command:orlof-xcbasic3.dasmPath} the DASM assembler. The DASM folder is also
    // on PATH in the task's shell, so the compiler finds DASM by itself. Avoid --dasm=<full path>: the
    // compiler cannot handle spaces in it.
    // See https://go.microsoft.com/fwlink/?LinkId=733558 for the tasks.json format.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "XC=BASIC Compile File",
            "type": "shell",
            "command": "${command:orlof-xcbasic3.compilerPath}",
            "args": [
                "--target=${config:xcbasic3.target}",
                "${file}",
                "${workspaceFolder}/build/${fileBasenameNoExtension}.prg"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$xcbasic3"
        },
        {
            "label": "XC=BASIC Run File",
            "type": "shell",
            "command": "${config:xcbasic3.emulator}",
            "args": [
                "${workspaceFolder}/build/${fileBasenameNoExtension}.prg"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "XC=BASIC Compile File"
            ],
            "problemMatcher": []
        },
        {
            "label": "XC=BASIC Debug File",
            "type": "shell",
            "command": "${config:xcbasic3.debugger}",
            "args": [
                "${workspaceFolder}/build/${fileBasenameNoExtension}.prg"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "XC=BASIC Compile File"
            ],
            "problemMatcher": []
        }
    ]
}
